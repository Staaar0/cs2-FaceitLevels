<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>CS2FaceitLevels</AssemblyName>
    <Version>1.1.0</Version>
    <RootNamespace>CS2FaceitLevels</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="lang\*.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="workshop.gamedata.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
